# Secrets : ne jamais versionner
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
*.jks

# Builds et dépendances
dist/
build/
out/
node_modules/
coverage/
.expo/
expo-env.d.ts
