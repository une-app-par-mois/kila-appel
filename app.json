{
  "expo": {
    "name": "Ki&La",
    "slug": "kila-appel",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.jitavision.kila",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jitavision.kila",
      "allowBackup": false,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/IBMPlexSans.ttf",
            "./assets/fonts/IBMPlexSans-SmBld.ttf",
            "./assets/fonts/IBMPlexSans-Bold.ttf",
            "./assets/fonts/IBMPlexMono-Medm.ttf"
          ]
        }
      ],
      "./plugins/withoutUrlScheme.js"
    ]
  }
}
